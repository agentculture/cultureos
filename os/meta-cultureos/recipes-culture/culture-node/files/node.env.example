# /var/lib/culture/node.env: optional settings for culture-node.service.
# Copy to /var/lib/culture/node.env (owner root or culture, mode 0640) and
# restart the unit. No secrets: link passwords never go in this file.
#
# Name of this node's server on the mesh (default: the hostname).
#CULTURE_NODE_NAME=ventuno
# Listen address and ports (culture defaults shown).
# Default: the tailnet IPv4; with none the node exits 75 and systemd retries
# every 30 s. Set 127.0.0.1 for a local-only node (never all interfaces).
#CULTURE_NODE_HOST=
#CULTURE_NODE_PORT=6667
#CULTURE_NODE_WEBHOOK_PORT=7680
# mesh.yaml with the peers to link to (used only if the file exists).
#CULTURE_NODE_MESH_CONFIG=/var/lib/culture/.culture/mesh.yaml
# Extra `culture server start` flags, e.g. --no-persist.
#CULTURE_NODE_EXTRA_ARGS=
