      "source": "steps.publish.outputs.stdout",
      "type": "string"
    },
    {
      "name": "bundle",
      "source": "steps.bundle.outputs.stdout",
      "type": "string"
    },
    {
      "name": "update",
      "source": "steps.notify.outputs.stdout",
      "type": "string"
    },
    {
      "name": "board_status",
      "source": "steps.status.outputs.stdout",
      "type": "string"
    }
  ],
